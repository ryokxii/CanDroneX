@startuml carte-contextes
title Cartographie du domaine — contextes délimités, services et relations (CanDroneX)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 70
skinparam package {
  BackgroundColor #F4F7FB
  BorderColor #2F4A6D
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2F4A6D
}
skinparam arrow {
  FontSize 10
}
hide members
hide methods
hide stereotype

' ── Rangée 1 : contextes amont, implémentés ────────────────────────

package "Customer Management (TMF629)" as customer {
  class Client <<(A,#2F4A6D)>>
  class ApiCredential <<(A,#2F4A6D)>>
  class TokenIssuanceService <<(S,#D79B00)>>
  class ClientDirectoryService <<(S,#D79B00)>>
  class "OnboardClientService — UC-01" as OnboardClientService <<(S,#D79B00)>> #line.dashed
}

package "Drone Management" as drone {
  class Drone <<(A,#2F4A6D)>>
  class "NetworkIdentity\nIMSI, ICCID, type de SIM" as NetworkIdentity <<(V,#82B366)>>
  class "RegisterDroneService — UC-02" as RegisterDroneService <<(S,#D79B00)>>
  class DroneDirectoryService <<(S,#D79B00)>>
}

package "Service Catalog (TMF633)" as catalog {
  class ServiceSpecification <<(A,#2F4A6D)>>
  class "CharacteristicSpecification\nvaleurs possibles" as CharacteristicSpecification <<(V,#82B366)>>
  class ServiceCatalogService <<(S,#D79B00)>>
}

' ── Rangée 2 : la commande ────────────────────────────────────────

package "Order Management (TMF641)" as order {
  class Order <<(A,#2F4A6D)>>
  class OrderLine <<(E,#6C8EBF)>>
  class "OrderedService\ncaractéristiques figées" as OrderedService <<(V,#82B366)>>
  class "PlaceOrderService — UC-04" as PlaceOrderService <<(S,#D79B00)>>
  class "OrderStatusPolicy\nétat global" as OrderStatusPolicy <<(D,#9673A6)>>
  class "ActivationResultHandler\ngestionnaire d'événements" as ActivationResultHandler <<(S,#D79B00)>> #line.dashed
}

' ── Rangée 3 : contextes prévus, modélisés et non implémentés ─────

package "Service Activation (TMF640) — prévu" as activation #line.dashed;line:7A8899 {
  class "Service" as ActivatedService <<(A,#2F4A6D)>> #line.dashed
  class ActivationAttempt <<(E,#6C8EBF)>> #line.dashed
  class "ActivateServiceService — UC-06" as ActivateServiceService <<(S,#D79B00)>> #line.dashed
  class "ResumeActivationService — UC-10" as ResumeActivationService <<(S,#D79B00)>> #line.dashed
  class "ActivationOutcomePolicy\nsuccès, échec, indéterminé" as ActivationOutcomePolicy <<(D,#9673A6)>> #line.dashed
}

package "Service Inventory (TMF638) — prévu" as inventory #line.dashed;line:7A8899 {
  class "Service" as InventoryService <<(A,#2F4A6D)>> #line.dashed
  class "ServiceInventoryQueryService — UC-07" as ServiceInventoryQueryService <<(S,#D79B00)>> #line.dashed
  class "ReconcileInventoryService — UC-13" as ReconcileInventoryService <<(S,#D79B00)>> #line.dashed
  class "DriftDetectionPolicy\ncommandé, provisionné, établi" as DriftDetectionPolicy <<(D,#9673A6)>> #line.dashed
}

package "Audit Trail — prévu" as audit #line.dashed;line:7A8899 {
  class "AuditEntry\najout seul" as AuditEntry <<(A,#2F4A6D)>> #line.dashed
  class "AuditWriterService — UC-08" as AuditWriterService <<(S,#D79B00)>> #line.dashed
  class "AuditQueryService — UC-12" as AuditQueryService <<(S,#D79B00)>> #line.dashed
}

class "Réseau 5G\n(Open5GS)" as network <<(X,#AAAAAA)>> #EEEEEE

' ── Disposition ───────────────────────────────────────────────────
customer -[hidden]right- drone
drone -[hidden]right- catalog
drone -[hidden]down- order
order -[hidden]down- activation
activation -[hidden]right- inventory
inventory -[hidden]right- network
audit -[hidden]right- activation

' ── Relations : du contexte aval vers le contexte amont ───────────

drone -[#2F4A6D]-> customer : ClientDirectory\n[client fournisseur]
order -[#2F4A6D]-> customer : ClientDirectory\n[client fournisseur]
order -[#2F4A6D]up-> drone : DroneDirectory : existence\net appartenance au client\n[client fournisseur]
order -[#2F4A6D]-> catalog : ServiceCatalog : spécification\nà figer [conformiste]

order -[#2F4A6D,dashed]down-> activation : demander l'activation\ndes lignes acceptées\n[client fournisseur]
activation .[#B85450].> order : événement :\nrésultat d'activation
activation -[#2F4A6D,dashed]-> drone : identité réseau\nrésolue à chaque tentative
activation -[#2F4A6D,dashed]right-> inventory : état courant\ndu service
activation -[#2F4A6D,dashed]-> network : approvisionner, relire\n[couche anticorruption]
inventory -[#2F4A6D,dashed]right-> network : lire l'état réel\n[couche anticorruption]

order -[#7A8899,dashed]-> audit : AuditWriter

legend bottom
  **Trait plein** : implémenté.  **Pointillé** : prévu — modélisé, non implémenté.
  Flèche **bleue** : appel synchrone vers l'interface publiée du contexte amont.
  Flèche **rouge** : événement de domaine, reçu par un gestionnaire du contexte aval.
  Flèche **grise** : écriture dans la piste d'audit ; tous les contextes l'emploieront, une seule est tracée.
  [client fournisseur], [conformiste], [couche anticorruption] : type de relation DDD.
  (A) agrégat   (E) entité   (V) objet-valeur   (X) système externe
  (S) service applicatif : orchestre un cas d'utilisation
  (D) service de domaine : règle métier qui ne relève d'aucun agrégat
endlegend
@enduml
