@startuml contexte-technique
!include <C4/C4_Context>

title Contexte technique — CanDroneX

AddRelTag("prevu", $lineStyle = DashedLine(), $textColor = "#7A8899", $lineColor = "#7A8899", $legendText = "interaction prévue, non implémentée")
AddElementTag("prevu", $borderStyle = DashedLine(), $legendText = "système externe intégré à une phase ultérieure")

System_Ext(clientB2B, "Système du client B2B", "Inspectra Drone Services : application qui gère la flotte de drones")

System(candronex, "CanDroneX", "Monolithe modulaire : clients, drones, catalogue et commandes ; activation et inventaire prévus")

System_Ext(reseau5G, "Réseau 5G — cœur Open5GS", "Profil d'abonné (WebUI ou MongoDB) et état des sessions (infoAPI)", $tags = "prevu")

Rel(clientB2B, candronex, "Enregistre ses drones et commande leurs services", "HTTPS / REST JSON, jeton Bearer JWT obtenu par OAuth 2.0 client_credentials")

Rel(candronex, reseau5G, "1. Demande l'activation : écrit la tranche au profil d'abonné, si elle n'y est pas déjà (S-NSSAI, DNN, 5QI, ARP, AMBR)", "Adaptateur Open5GsProvisioningAdapter, port ProvisioningPort", $tags = "prevu")
Rel_Back(candronex, reseau5G, "2. Répond : succès, refus explicite, ou délai dépassé — issue indéterminée", "Réponse synchrone de l'API de provisionnement", $tags = "prevu")
Rel(candronex, reseau5G, "3. Consulte l'état réel avant toute reprise et lors des réconciliations", "infoAPI :9090 (/pdu-info, /ue-info), même adaptateur", $tags = "prevu")

SHOW_LEGEND()
@enduml
