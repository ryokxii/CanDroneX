<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.candronex</groupId>
  <artifactId>candronex</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>candronex</name>
  <description>CanDroneX — Phase 2, microservices (UC-02, UC-04, UC-06)</description>

  <!-- platform : code technique commun seulement, aucun type du domaine. -->
  <modules>
    <module>platform</module>
    <module>drone-service</module>
    <module>order-service</module>
    <module>slice-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- 1.21.4+ : requis par Docker Engine 29 (API minimale 1.40) -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.candronex</groupId>
        <artifactId>platform</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- mvn test : *Test, sans Docker. mvn verify : ajoute les *IT (Docker requis). -->
        <!--
          Mockito instrumente les classes avec Byte Buddy, qui refuse les
          versions de JVM plus récentes que celles qu'il connaît. Le code
          cible Java 21, mais rien n'empêche d'exécuter la suite sur un JDK
          plus récent : ce drapeau autorise l'instrumentation dans ce cas.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>-Dnet.bytebuddy.experimental=true</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <argLine>-Dnet.bytebuddy.experimental=true</argLine>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
